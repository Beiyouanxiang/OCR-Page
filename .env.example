# 智谱 GLM-OCR 的 API Key，从 https://open.bigmodel.cn 获取
# Bookmark-Page 项目里用的同一个 GLM_API_KEY 可以直接复用
GLM_API_KEY=your-glm-api-key

# 用于签发登录 JWT，生产环境必须设置，长度建议 >= 32 字节
# 可用 openssl rand -hex 32 生成
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# 注册邀请码。生产环境必须设置；如果为空，则允许任意人注册
INVITE_CODE=your-invite-code

# 服务监听配置
PORT=3001
HOST=127.0.0.1

# 可选：每 10 分钟每个用户的识别次数上限（默认 40）
# RATE_MAX=40

# 可选：单次识别超时（毫秒，默认 120000）
# OCR_TIMEOUT_MS=120000
